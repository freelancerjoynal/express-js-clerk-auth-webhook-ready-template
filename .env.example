PORT=8000

# Prisma connection string (Uses localhost for local machine development)
DATABASE_URL="postgresql://clerk:clerk_pass@localhost:5432/clerk_db?schema=public"

# Database credentials used by Docker
POSTGRES_USER=clerk
POSTGRES_PASSWORD=clerk_pass
POSTGRES_DB=clerk_db

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_from_clerk_dashboard
CLERK_SECRET_KEY=sk_test_your_secret_key_from_clerk_dashboard
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_from_clerk_dashboard